# Strapi - Open-source headless CMS
# Copy to app.env and customize

# Timezone
TZ=America/New_York

# Hostname
BASE_HOST_NAME=$HOSTNAME

# Strapi server
STRAPI_HOST=0.0.0.0
STRAPI_PORT=1337

# Secrets (all must be unique, min 32 chars)
APP_SECRET_KEY=changeme_secret_key_min_32_chars
API_TOKEN_SALT=changeme_api_token_salt_32chars
ADMIN_JWT_SECRET=changeme_admin_jwt_secret_32c
TRANSFER_TOKEN_SALT=changeme_transfer_token_salt32

# Database (sqlite, postgres, mysql)
DATABASE_CLIENT=sqlite
